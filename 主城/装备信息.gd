# 角色装备（按第1~4件顺序，与存档"强化"数组索引一一对应）
static func get_helo(helo: String) -> Array:
	if helo == "爱丽丝":
		return ["繁荣", "紫锋", "紫雾", "贯虹"]
	elif helo == "玄戈":
		return ["耀焰", "战意", "圣辉", "黎明"]
	elif helo == "秤干戚":
		return ["秤心", "鸿泰", "坚韧", "蝴蝶"]
	return []
