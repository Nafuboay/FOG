# 角色装备
static func get_helo(helo: String) -> Array:
	if helo == "爱丽丝":
		return ["繁荣", "紫锋", "紫雾", "贯虹"]
	elif helo == "玄戈":
		return ["耀焰", "战意", "圣辉", "黎明"]
	return []
