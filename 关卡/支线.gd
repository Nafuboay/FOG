# 【支线模式】关卡逻辑
# 与主线共用同一套关卡数据：地图尺寸、怪物配置、BOSS配置、魔法树随机生成全部与主线一致
# 与主线的差异只有三点：
#   1. 普通怪物：排雷×3、显示大小0.75；踩雷×4、显示大小1.0
#      倍率同时作用于【等级、生命、力量、防御、穿透】
#   2. BOSS：等级×4、血量 = 基础HP×32×BOSS等级（=×128）、显示大小2，力量/防御/穿透也×4
#   3. 通关结算：经验按普通怪×27、BOSS×512；进度按「支线·n关 = 30+n」推进（主线30关全通后才开放第1关）
# 撤退按钮保留（与主线一致）
extends 关卡基类

# 覆盖_ready：先设置支线专属参数，再执行基类的完整初始化流程
func _ready() -> void:
	# 支线专属倍率必须在基类初始化（生成怪物/BOSS）之前设置
	_zhi_xian_bei_zhi()
	# 调用基类_ready（加载关卡数据、建网格、生成怪物与BOSS、创建人物与UI）
	super()

# 设置支线模式专属参数（相对主线的改动）
func _zhi_xian_bei_zhi() -> void:
	# 排雷怪物：等级/生命/力量/防御/穿透 ×3，显示大小0.75
	pai_lei_bei = 3
	pai_lei_scale = 0.75
	# 踩雷怪物：等级/生命/力量/防御/穿透 ×4，显示大小1.0（与主线一致）
	cai_lei_bei = 4
	cai_lei_scale = 1.0
	# BOSS：等级倍率×4，血量系数32（生命 = 基础HP × 32 × BOSS等级），显示大小2
	BOSS_lv_bei = 4
	BOSS_xue_bei = 32.0
	BOSS_scale = 2.0

# 支线模式标记方法（供死亡处理识别支线并向关卡UI转发胜利结算）
func _zhi_xian_win() -> void:
	if guan_ui != null:
		guan_ui.C_zhi_xian_sheng_li()
