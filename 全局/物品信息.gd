# 获取物品详细信息
static func get_XX(wu_ming: String) -> Dictionary:
	return wu_pin_XX.get(wu_ming, {})

# 判断物品是否可出售（在不可出售名单中的物品返回false）
static func shi_fou_ke_chu_shou(wu_ming: String) -> bool:
	return not bu_ke_chu_shou.has(wu_ming)

# 判断物品是否为强化材料
static func shi_fou_QH_CL(wu_ming: String) -> bool:
	var XX = get_XX(wu_ming)
	var yong_tu = XX.get("用途", "")
	return yong_tu.find("阶材料") != -1

# 强化材料对第1~4件装备的银币消耗倍率表
# 格式：{材料名: [装备1倍率, 装备2倍率, 装备3倍率, 装备4倍率]}
# 未配置的材料默认倍率为 [1, 1, 1, 1]
const QH_bei_lv = {
	"百合": [1.75, 0.75, 0.75, 0.75],
	"水仙": [0.75, 1.75, 0.75, 0.75],
	"玫瑰": [0.75, 0.75, 1.75, 0.75],
	"鸢尾": [0.75, 0.75, 0.75, 1.75],
	"邪藤蔓": [2.0, 0.5, 0.5, 1.0],
	"野猪王牙": [0.5, 1.0, 0.5, 2.0],
	"魔王核": [1.0, 1.0, 1.0, 1.0],
	"狼王尾": [0.5, 1.5, 1.5, 0.5],
	"绿象牙": [0.5, 1.0, 0.5, 2.0],
	"蟹钳": [0.4, 1.2, 1.2, 1.2],
	"藤蔓": [2.0, 0.5, 0.5, 1.0],
	"野猪皮": [1.0, 0.5, 2.0, 0.5],
	"魔核": [1.0, 1.0, 1.0, 1.0],
	"狼尾": [0.5, 1.5, 1.5, 0.5],
	"象牙": [0.5, 1.0, 0.5, 2.0],
}

# 获取某材料对指定装备位的强化倍率（装备位 zb_idx 从0开始，默认1.0）
static func get_QH_bei_lv(wu_ming: String, zb_idx: int) -> float:
	if QH_bei_lv.has(wu_ming):
		var arr = QH_bei_lv[wu_ming]
		if zb_idx >= 0 and zb_idx < arr.size():
			return float(arr[zb_idx])
	return 1.0
